{
  "$comment": "Every allowed pairing of a foreground token on a background token. The contrast test reads this file and tokens.css. A component may only use a pairing listed here. The spec field holds the figure the specification prints for the dark and light sets. It is checked, never copied into the page.",
  "sets": [
    "light",
    "dark",
    "light-more",
    "dark-more"
  ],
  "thresholds": {
    "standard": {
      "body": 7,
      "muted": 4.5,
      "mark": 3
    },
    "more": {
      "body": 7,
      "muted": 7,
      "mark": 4.5
    }
  },
  "roles": {
    "body": "Body text. 7:1 aimed for.",
    "muted": "Secondary text and short labels. 4.5:1 is the floor.",
    "mark": "Lines, marks, meaningful borders and focus rings. 3:1.",
    "decorative": "No minimum. Never the only cue, because it can be missing without loss."
  },
