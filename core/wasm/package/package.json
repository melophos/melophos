{
  "name": "@melophos/core",
  "version": "0.1.0",
  "description": "The MELOPHOS scoring engine for the browser: WebAssembly and a typed wrapper",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./melophos_core_wasm_bg.wasm": "./pkg/melophos_core_wasm_bg.wasm"
  },
  "files": [
    "dist",
    "pkg/melophos_core_wasm.js",
    "pkg/melophos_core_wasm.d.ts",
    "pkg/melophos_core_wasm_bg.wasm",
    "pkg/melophos_core_wasm_bg.wasm.d.ts"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "build": "tsc -p tsconfig.build.json"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  }
}
