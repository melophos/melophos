# local data from the compose stack
server/deploy/data/

# editors and os
.DS_Store
.idea/
*.swp

# rust
core/target/
core/wasm/package/pkg/

# the hub firmware reads its Wi-Fi and device settings from this file, which is never committed
firmware/include/secrets.h

# the compiled scoring module is built by maturin and differs per machine
core/python/python/melophos_core/_native.*

# local browser audit output and fuzzing state, never published
studio/.lighthouseci-app/
studio/.fuzz/
