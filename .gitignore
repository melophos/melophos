# environment and secrets
.env
.env.*
!.env.example

# python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
dist/
build/

# node
node_modules/
studio/dist/
studio/dist-specimen/
studio/.lighthouseci/
studio/test-results/
studio/playwright-report/
studio/specimen-screenshots/

# platformio
firmware/.pio/
firmware/.vscode/

# kicad backups and outputs
hardware/**/*-backups/
hardware/**/*.kicad_prl
hardware/**/fp-info-cache
