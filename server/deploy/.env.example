# do not copy this by hand: run deploy/generate-env.sh, which makes .env with random secrets.
# the server refuses to start with any value from this file. never commit the real .env.

# postgres (timescaledb)
POSTGRES_USER=melophos
POSTGRES_PASSWORD=change-me
POSTGRES_DB=melophos
# POSTGRES_USER and POSTGRES_PASSWORD are the superuser. Only the database and the db-roles step see them
# the owner (not a superuser) that runs the migrations. Only the migrate step sees it
POSTGRES_OWNER_PASSWORD=change-me-owner
# the limited role the server and worker use: read and write its tables and nothing else
POSTGRES_APP_PASSWORD=change-me-app

# mqtt broker the hubs publish to
MQTT_HOST=mqtt
MQTT_PORT=1883
# the server's own login for reading hub traffic, created on the broker at start
MQTT_USERNAME=melophos-server
MQTT_PASSWORD=change-me
# the broker administrator, used to create the roles and one login per paired hub
MQTT_ADMIN_USERNAME=melophos-admin
MQTT_ADMIN_PASSWORD=change-me-as-well
# the plain port 1883 is for the server and worker. It is published on this machine only. Set 0.0.0.0 only
# for development with a hub that cannot do TLS
# API_BIND=127.0.0.1 publishes the API on this machine only, so put a TLS reverse proxy in front
MQTT_PLAIN_BIND=127.0.0.1

# server
# at least 32 random characters, for example `openssl rand -base64 48`. It seals webhook secrets and keys pairing
# codes. Changing it makes stored webhook secrets unreadable, so keep it with your backups
SECRET_KEY=generate-a-long-random-string-of-at-least-32-characters
CORS_ORIGINS=http://localhost:5173
# set to false once your household has signed up
ALLOW_SIGNUP=true
# how many reverse proxies sit in front of the server (0 if none), so rate limits see the real client address
# the name of this server process for hub traffic. Its broker login and queue are built from it. A second process
# (a replica) needs a name of its own, for example MQTT_INSTANCE=second. For a maintenance run such as
# `docker compose run server ...` set INGEST_ENABLED=false so it does not take ingest over
MQTT_INSTANCE=main
INGEST_ENABLED=true
TRUSTED_PROXY_HOPS=0
# the address the proxy connects from as the server sees it, for example 172.18.0.1/32. Required when the hops are
# above 0. Nothing else is believed to set X-Forwarded-For
TRUSTED_PROXY_CIDRS=
# optional: a bearer token that /metrics then requires
# the Prometheus scrape token. /metrics is off until this is set. Put the same value in
# monitoring/metrics_token. Leave Grafana off unless GRAFANA_ADMIN_PASSWORD is set too
METRICS_TOKEN=
GRAFANA_ADMIN_PASSWORD=

# development only: start without the scoring engine and score with a simple stand-in. Leave false in production
ALLOW_STAND_IN_SCORER=false

# whether the server tells hubs its clock is synchronised. auto asks the kernel. Set true if the kernel cannot be asked
# on your machine and you know the time is kept right or false to hold hubs back. See docs/self-hosting.md
CLOCK_SYNC=auto

# optional integrations, leave blank to disable
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:8000/api/v1/integrations/spotify/callback
WLED_HOST=
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=
# one address that receives every finished session. The secret signs each delivery and is needed with the URL
SESSION_WEBHOOK_URL=
SESSION_WEBHOOK_SECRET=
