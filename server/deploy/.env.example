# copy to .env and fill in. never commit the real .env.

# postgres (timescaledb)
POSTGRES_USER=melophos
POSTGRES_PASSWORD=change-me
POSTGRES_DB=melophos
DATABASE_URL=postgresql://melophos:change-me@db:5432/melophos

# redis queue for the transcription worker
REDIS_URL=redis://redis:6379/0

# mqtt broker the hubs publish to
MQTT_HOST=mqtt
MQTT_PORT=1883
MQTT_USERNAME=melophos
MQTT_PASSWORD=change-me

# object storage for recordings and imported songs
MINIO_ROOT_USER=melophos
MINIO_ROOT_PASSWORD=change-me-too
S3_ENDPOINT=http://minio:9000
S3_BUCKET=melophos

# server
SECRET_KEY=generate-a-long-random-string
CORS_ORIGINS=http://localhost:5173

# optional integrations, leave blank to disable
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:8000/api/v1/integrations/spotify/callback
WLED_HOST=
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=
SESSION_WEBHOOK_URL=
