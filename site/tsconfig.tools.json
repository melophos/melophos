{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["node"],
    "lib": ["ES2023", "DOM"]
  },
  "include": ["scripts/**/*.ts", "tests/**/*.ts", "playwright*.ts", "src/lib/**/*.ts", "src/data/**/*.ts", "src/site.config.ts", "src/client/**/*.ts", "src/raw.d.ts"]
}
