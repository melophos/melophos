{
  "name": "melophos-site",
  "version": "0.2.0",
  "private": true,
  "description": "The public MELOPHOS website: a Next.js app exported as static files from the monorepo",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev --webpack --port 23180",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tools.json",
    "test": "vitest run",
    "build": "npm run typecheck && npm run build:only && node scripts/verify-dist.ts",
    "build:production": "MELOPHOS_PRODUCTION=1 npm run build",
    "build:only": "NEXT_TELEMETRY_DISABLED=1 next build --webpack && node scripts/finish-export.ts",
    "preview": "node scripts/serve-dist.ts 23190",
    "check:links": "node scripts/verify-dist.ts --links-only",
    "check:live": "node scripts/check-live.ts",
    "check:licences": "node scripts/check-licences.ts",
    "check:a11y": "npm run build:only && playwright test --config playwright.config.ts",
    "check:lighthouse": "npm run build:only && lhci autorun",
    "social": "node scripts/social-images.ts",
    "shots": "npm run build:only && playwright test --config playwright.shots.config.ts",
    "check": "npm run typecheck && npm test && npm run build && npm run check:licences && npm run check:a11y && npm run check:lighthouse"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@lhci/cli": "0.16.1",
    "@phosphor-icons/core": "2.1.1",
    "@playwright/test": "1.65.1",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.14.1",
    "license-checker-rseidelsohn": "5.0.1",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  },
  "dependencies": {
    "github-slugger": "2.0.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5"
  }
}
